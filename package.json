{
  "name": "agent-trajectory-eval",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Scoring the path an agent took rather than just its final answer: redundant calls, recovery from errors, dead ends. Final-answer accuracy hides all of it.",
  "scripts": {
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "agent": "node --env-file-if-exists=.env scripts/run.mjs",
    "spend": "node scripts/spend.mjs",
    "import-legacy": "node scripts/import-legacy.mjs",
    "render": "node scripts/render.mjs",
    "score": "node scripts/score.mjs",
    "corpus": "bash scripts/corpus.sh",
    "agreement": "node scripts/agreement.mjs",
    "summary": "node scripts/summary.mjs",
    "judge": "node --env-file-if-exists=.env scripts/judge.mjs",
    "fleet": "node scripts/generate-fleet.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0"
  }
}
